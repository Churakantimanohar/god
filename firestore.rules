rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole(request.auth.uid) == 'admin';
    }

    function isCommittee() {
      return isSignedIn() && userRole(request.auth.uid) == 'committee';
    }

    function isPublicUser() {
      return isSignedIn() && userRole(request.auth.uid) == 'public';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        isAdmin() || request.auth.uid == userId || isCommittee()
      );
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'public';
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.role != 'admin'
      );
      allow delete: if isAdmin();
    }

    match /festivals/{festivalId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.donorId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.donorId == request.auth.uid && resource.data.status != 'verified'
      );
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow create: if isCommittee() || isAdmin();
      allow update: if isAdmin() || (
        isCommittee() && resource.data.createdBy == request.auth.uid && resource.data.status != 'verified'
      );
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
